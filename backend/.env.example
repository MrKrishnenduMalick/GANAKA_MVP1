# =============================================================================
# Ganaka Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.
# Corrected 2026-08 to match app/core/config.py exactly (several variable
# names below had drifted from what the code actually reads) — see
# FIX_SUMMARY.md and ARCHITECTURE_AUDIT.md for the full remediation history.
# =============================================================================

# --- Core (required) ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="ganaka"
JWT_SECRET="<generate a long random secret>"
JWT_ALGORITHM="HS256"
API_PREFIX="/api/v1"

# --- CORS / deployment origin ---
# As of 2026-08 (ARCHITECTURE_AUDIT.md #11) a wildcard "*" here is never
# honored while credentialed requests are enabled (they always are). Set an
# explicit, comma-separated origin list in production. If left unset, the API
# falls back to APP_BASE_URL below; if neither is set, cross-origin
# credentialed requests are rejected (fails closed, not open).
CORS_ORIGINS="http://localhost:3000,https://your-domain.com"
APP_BASE_URL="https://your-domain.com"

# --- Environment / test endpoints ---
# Added 2026-08 (ARCHITECTURE_AUDIT.md #12). Leave ENABLE_TEST_ENDPOINTS unset
# (or "false") and ENVIRONMENT="production" in any real deployment — this
# keeps the /shopify/webhooks/test replay endpoint disabled.
ENVIRONMENT="production"
ENABLE_TEST_ENDPOINTS="false"

# --- Tokens ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Sessions ---
SESSION_IDLE_TIMEOUT_MINUTES=30
MAX_ACTIVE_SESSIONS=5

# --- Security ---
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15
INVITATION_TTL_DAYS=7
MAX_CUSTOM_ROLES=50
MAX_PERMISSIONS_PER_ROLE=200

# --- Email (SMTP) ---
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT=587
SMTP_USERNAME="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@your-domain.com"

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=""

# --- Shopify (optional) ---
# SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET are also accepted as aliases for
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET below (app/core/config.py falls back to
# them if the *_API_* names are unset) — set one pair, not both.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,read_products,read_customers"
SHOPIFY_APP_URL="https://your-domain.com"
SHOPIFY_OAUTH_STATE_TTL_MINUTES=15

# --- Encryption (required if Shopify and/or Razorpay integrations are used) ---
# AES-256 key, 32 bytes, base64-encoded. Encrypts Shopify OAuth tokens and
# (as of 2026-08) each workspace's own Razorpay credentials at rest.
ENCRYPTION_KEY=""

# --- Razorpay ---
# Corrected 2026-08 (ARCHITECTURE_AUDIT.md #1): Razorpay credentials are
# per-workspace now, supplied via POST /razorpay/connect and encrypted with
# ENCRYPTION_KEY above — there is no deployment-wide RAZORPAY_KEY_ID /
# RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET any more. The only
# deployment-level Razorpay setting is the sync polling interval below.
RAZORPAY_SYNC_TTL_MINUTES=60
