# Ganaka Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# Added 2026-08 for consistency with backend/.env.example (this file did not
# previously exist, even though frontend/.env did).

# Base URL of the Ganaka backend API (the frontend appends /api/v1 itself).
REACT_APP_BACKEND_URL="https://your-backend-domain.com"

# CRACO/webpack-dev-server socket port (dev only; irrelevant in production builds).
WDS_SOCKET_PORT=443

# Optional health-check ping toggle.
ENABLE_HEALTH_CHECK=false
